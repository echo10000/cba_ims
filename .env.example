# CBA IMS Environment Configuration
# Copy this file to .env and fill in the values for your environment.
# NEVER commit .env to version control.

# ---------------------------------------------------------------------------
# Core Django Settings
# ---------------------------------------------------------------------------

# REQUIRED: Generate a strong unique key for production.
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# Set to False in production. Never use True in production.
DEBUG=False

# Comma-separated list of allowed hostnames. No wildcards in production.
# Example: ALLOWED_HOSTS=yourdomain.edu.ph,www.yourdomain.edu.ph
ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated list of trusted HTTPS origins for CSRF protection.
# Example: DJANGO_CSRF_TRUSTED_ORIGINS=https://yourdomain.edu.ph
DJANGO_CSRF_TRUSTED_ORIGINS=

# ---------------------------------------------------------------------------
# Database (PostgreSQL required for production)
# ---------------------------------------------------------------------------

# Option A: Use DATABASE_URL connection string (overrides individual DB_ settings)
# DATABASE_URL=postgres://DB_USER:DB_PASSWORD@DB_HOST:5432/DB_NAME
DATABASE_URL=

# Option B: Individual parameters (used when DATABASE_URL is not set)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=cba_ims
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# ---------------------------------------------------------------------------
# Security Headers (recommended for production HTTPS deployments)
# ---------------------------------------------------------------------------

# Redirect HTTP to HTTPS (set to True when HTTPS is active)
SECURE_SSL_REDIRECT=False

# Enable when behind a trusted reverse proxy terminating HTTPS
# (e.g., Nginx with proxy_set_header X-Forwarded-Proto https)
# Set to True ONLY when your reverse proxy is correctly configured.
SECURE_PROXY_SSL_HEADER=False

# HSTS: Start at 0 and increase gradually after confirming HTTPS works.
# 31536000 = 1 year. Do NOT enable preload before testing thoroughly.
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# ---------------------------------------------------------------------------
# Application Settings
# ---------------------------------------------------------------------------

# Timezone (e.g., Asia/Manila, UTC)
TIME_ZONE=UTC
